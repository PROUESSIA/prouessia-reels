 "textes": {
  "julien": [
   "Vasseur. Qu'est-ce que vous faites là ?",
   "Il ment. C'est lui qui a ouvert l'eau.",
   "Moi. Quelqu'un est entré chez madame."
  ],
  "vasseur": [
   "Je pourrais vous poser la même question, Morel.",
   "Votre voisine a appelé mon numéro d'urgence, madame : l'eau passait sous votre porte. La clé était sur la serrure. Je suis entré couper l'eau.",
   "La prochaine, c'est madame Lefèvre."
  ],
  "rocher": [
   "Monsieur Vasseur ? Vous êtes venu pour la fuite ?",
   "Monsieur Morel, oui, je l'ai appelé. Et monsieur Vasseur… c'est mon plombier."
  ],
  "policier": [
   "Police ! Qui nous a appelés ?",
   "Madame, vous connaissez ces messieurs ?",
   "Une fuite, la clé sur la porte, pas d'effraction. Monsieur Vasseur, vous avez fini ici : vous partez. Madame, si vous voulez, venez porter plainte demain."
  ]
 },
