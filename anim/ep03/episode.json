 "textes": {
  "vasseur": [
   "Je pourrais vous poser la même question, Morel.",
   "Je passais vérifier votre robinet, madame. Heureusement.",
   "Messieurs, cet homme est entré chez ma cliente en pleine nuit.",
   "Et je suis là, madame.",
   "La prochaine, c'est madame Lefèvre."
  ],
  "julien": [
   "Vasseur. Qu'est-ce que vous faites là ?",
   "Il ment. C'est lui qui a ouvert l'eau.",
   "Moi. Quelqu'un est entré chez madame.",
   "Madame, c'est vous qui m'avez appelé !"
  ],
  "rocher": [
   "Monsieur Vasseur ? Vous êtes venu pour la fuite ?",
   "Monsieur Vasseur, oui. Lui… je ne l'ai jamais vu.",
   "J'ai appelé… un plombier."
  ],
  "policier": [
   "Police ! Qui nous a appelés ?",
   "Madame, vous connaissez ces messieurs ?",
   "Monsieur Morel, vous allez nous suivre."
  ]
 },
