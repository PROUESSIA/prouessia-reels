 "textes": {
  "theo": [
   "Donc mon premier jour, c'est surveiller une mamie ?",
   "Regardez. Le type en imperméable, tout à l'heure. Il a glissé ça dans une boîte aux lettres.",
   "Le numéro douze. C'est écrit Dumas."
  ],
  "julien": [
   "Tu voulais du concret, Théo. Ouvre l'œil.",
   "Quelle boîte, Théo ?"
  ],
  "lea": [
   "Bonsoir, madame Lefèvre. Je passe pour votre tension, comme promis.",
   "Ça coûte combien ?",
   "Il a tout dit. Et j'ai tout enregistré.",
   "Dumas… c'est ma mère."
  ],
  "lefevre": [
   "Entrez, ma petite. Monsieur Vasseur ne va pas tarder."
  ],
  "vasseur": [
   "Bonsoir, mesdames. Une serrure toute neuve, pour votre sécurité.",
   "Une petite signature, là. C'est pour votre tranquillité.",
   "Ne vous occupez pas de ça. C'est prélevé tout seul.",
   "Vous saluerez monsieur Morel de ma part."
  ]
 },
