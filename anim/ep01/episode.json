 "textes": {
  "yanis": [
   "Coupez le compteur. J'arrive.",
   "Elle a quatre-vingts ans, Léa.",
   "Le robinet d'arrêt… il tourne dans le vide.",
   "Quelqu'un l'a changé récemment ?",
   "Combien il vous a pris ?",
   "Pour une pièce à dix euros…",
   "Cinq étoiles… et des robinets qui lâchent en pleine nuit.",
   "Je vais appeler ses autres clients.",
   "Comment il a eu mon numéro ?"
  ],
  "lea": [
   "Yanis… il est trois heures du matin.",
   "Vasseur Dépannage… cinq étoiles partout.",
   "Tu vas faire quoi ?"
  ],
  "lefevre": [
   "Monsieur Morel ? C'est madame Lefèvre… L'eau… elle sort de partout !",
   "Je n'arrive pas à fermer le robinet !",
   "Oui, la semaine dernière. Un monsieur très gentil. Vasseur Dépannage.",
   "Huit cent quatre-vingt-dix euros."
  ],
  "narrateur": [
   "Sous pression. Une série présentée par Prouessia, le partenaire des plombiers.",
   "Épisode deux, demain, dix-huit heures."
  ]
 },
